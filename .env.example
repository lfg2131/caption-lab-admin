# Same Supabase project as Caption Lab. URL and publishable/anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never commit, never log.
# Local: .env.local. Vercel: Sensitive variable. Used only after the Google
# session AND caption_lab_admins.is_superadmin have been verified.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Gemini key for "Create an AI caption".
GEMINI_API_KEY=your-gemini-api-key
# Optional model override; defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
